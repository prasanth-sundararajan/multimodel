# Copy to .env and fill in your own values. Never commit .env.
# OpenAI API key used for chat and embeddings
OPENAI_API_KEY=
# true to enable LangSmith tracing (optional)
LANGCHAIN_TRACING_V2=
# LangSmith API key (optional)
LANGCHAIN_API_KEY=
# LangSmith project name (optional)
LANGCHAIN_PROJECT=
# LangSmith endpoint (optional)
LANGCHAIN_ENDPOINT=
